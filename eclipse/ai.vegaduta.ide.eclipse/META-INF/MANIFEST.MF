Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: VegaDūta for Eclipse
Bundle-SymbolicName: ai.vegaduta.ide.eclipse;singleton:=true
Bundle-Version: 0.4.1.qualifier
Bundle-Vendor: VegaDuta
Bundle-Activator: ai.vegaduta.ide.eclipse.VegadutaPlugin
Bundle-RequiredExecutionEnvironment: JavaSE-17
Automatic-Module-Name: ai.vegaduta.ide.eclipse
Bundle-ActivationPolicy: lazy
Require-Bundle: org.eclipse.ui,
 org.eclipse.swt,
 org.eclipse.jface,
 org.eclipse.core.runtime,
 org.eclipse.core.expressions,
 org.eclipse.equinox.security,
 org.eclipse.jface.text,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.core.resources,
 org.eclipse.core.filesystem,
 org.eclipse.ui.ide
Bundle-ClassPath: .
